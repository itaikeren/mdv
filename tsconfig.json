{
  // Vercel's Node function builder compiles the `api/[[...path]].ts` entrypoint and
  // looks for a tsconfig at the repo root. Without this file it falls back to its own
  // defaults (strict off), where discriminated unions like AnchorResolution stop
  // narrowing and `tsc` reports phantom TS2339 errors during the build. Mirror the
  // app's settings so the function build typechecks exactly like `pnpm build` does.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "apps/api/**/*.ts", "packages/shared/**/*.ts"],
  "exclude": ["node_modules", "**/dist"]
}
